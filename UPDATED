/* ============================================================
   GLOBAL SEARCH
   ------------------------------------------------------------
   Indexes every content block in every tab on page load.
   - Type to search (or press "/" anywhere to focus)
   - ↑ / ↓ to move through results, Enter to jump, Esc to close
   - Jumping switches tabs, opens the parent accordion, scrolls
     to the block and flashes it.
   No config needed — new content is picked up automatically.
   ============================================================ */
const SEARCH_INDEX = [];
const BLOCK_SELECTOR = '.card, .tool-card, .accordion, .alert, .step-item, .checklist-item, .stat-box';

function buildSearchIndex() {
  document.querySelectorAll('.tab-panel').forEach(panel => {
    const key = panel.id.replace('panel-', '');
    const tabBtn = document.getElementById('tab-' + key);
    const tabLabel = tabBtn ? tabBtn.textContent.replace(/In Progress/i, '').trim() : key;
    const pageTitle = panel.querySelector('.page-title');
    const sectionName = pageTitle ? pageTitle.textContent.trim() : tabLabel;

    // Index the section header itself
    SEARCH_INDEX.push({
      tabKey: key, tabLabel, el: pageTitle ? pageTitle.closest('.page-hdr') : panel,
      title: sectionName,
      text: (panel.querySelector('.page-desc') ? panel.querySelector('.page-desc').textContent : '')
    });

    panel.querySelectorAll(BLOCK_SELECTOR).forEach(el => {
      // Skip blocks nested inside another indexed block (avoids duplicates)
      if (el.parentElement.closest(BLOCK_SELECTOR)) return;
      const text = el.innerText.replace(/\s+/g, ' ').trim();
      if (!text) return;
      SEARCH_INDEX.push({ tabKey: key, tabLabel, el, title: blockTitle(el), text });
    });
  });
}

function blockTitle(el) {
  const t = el.querySelector('.card-title, .acc-title, .alert-title, .step-text, .checklist-text strong, .stat-label');
  let title = t ? t.textContent.trim() : el.innerText.trim().split('\n')[0];
  return title.length > 90 ? title.slice(0, 90) + '…' : title;
}

function escHtml(s){ return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function escRe(s){ return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

function markAll(str, terms) {
  let out = escHtml(str);
  terms.forEach(t => { out = out.replace(new RegExp('(' + escRe(t) + ')', 'gi'), '<mark>$1</mark>'); });
  return out;
}

function snippet(text, terms) {
  const low = text.toLowerCase();
  let idx = -1;
  for (const t of terms) { const i = low.indexOf(t.toLowerCase()); if (i > -1 && (idx === -1 || i < idx)) idx = i; }
  if (idx === -1) idx = 0;
  const start = Math.max(0, idx - 55);
  const end = Math.min(text.length, idx + 125);
  return (start > 0 ? '… ' : '') + markAll(text.slice(start, end), terms) + (end < text.length ? ' …' : '');
}

let searchHits = [];
let activeHit = -1;

function runSearch(q) {
  const box = document.getElementById('search-results');
  const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
  searchHits = []; activeHit = -1;

  if (!terms.length) { box.classList.remove('open'); box.innerHTML = ''; return; }

  SEARCH_INDEX.forEach((entry, i) => {
    const hay = (entry.title + ' ' + entry.text + ' ' + entry.tabLabel).toLowerCase();
    if (!terms.every(t => hay.includes(t))) return;
    let score = 0;
    terms.forEach(t => {
      if (entry.title.toLowerCase().includes(t)) score += 10;
      if (entry.tabLabel.toLowerCase().includes(t)) score += 4;
      score += (entry.text.toLowerCase().split(t).length - 1);
    });
    searchHits.push({ ...entry, score, idx: i });
  });

  searchHits.sort((a, b) => b.score - a.score);
  searchHits = searchHits.slice(0, 40);

  if (!searchHits.length) {
    box.innerHTML = '<div class="sr-empty"><span class="big">🔍</span>No matches for <strong>' + escHtml(q) + '</strong><br>Try a status name, a tool (UpGuard, TDX, HECVAT), or a person.</div>';
    box.classList.add('open');
    return;
  }

  let html = '<div class="search-meta">' + searchHits.length + ' result' + (searchHits.length === 1 ? '' : 's') + ' — ↑ ↓ to browse, Enter to open</div>';
  let lastTab = null;
  searchHits.forEach((hit, i) => {
    if (hit.tabLabel !== lastTab) { html += '<div class="sr-group">' + escHtml(hit.tabLabel) + '</div>'; lastTab = hit.tabLabel; }
    html += '<div class="sr-item" data-hit="' + i + '">' +
              '<div class="sr-title">' + markAll(hit.title, terms) + '</div>' +
              '<div class="sr-snip">' + snippet(hit.text, terms) + '</div>' +
            '</div>';
  });
  box.innerHTML = html;
  box.classList.add('open');

  box.querySelectorAll('.sr-item').forEach(item => {
    item.addEventListener('click', () => gotoHit(parseInt(item.dataset.hit, 10)));
  });
}

function gotoHit(i) {
  const hit = searchHits[i];
  if (!hit) return;
  switchTab(hit.tabKey);

  // Open the accordion (or the one containing this block) if collapsed
  const acc = hit.el.classList.contains('accordion') ? hit.el : hit.el.closest('.accordion');
  if (acc) {
    const head = acc.querySelector('.acc-head'), body = acc.querySelector('.acc-body');
    if (head && !head.classList.contains('open')) { head.classList.add('open'); body.classList.add('open'); }
  }

  closeSearch();
  setTimeout(() => {
    hit.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    hit.el.classList.remove('search-flash');
    void hit.el.offsetWidth;
    hit.el.classList.add('search-flash');
    setTimeout(() => hit.el.classList.remove('search-flash'), 2000);
  }, 60);
}

function setActiveHit(n) {
  const items = document.querySelectorAll('.sr-item');
  if (!items.length) return;
  activeHit = (n + items.length) % items.length;
  items.forEach(el => el.classList.remove('active'));
  const cur = items[activeHit];
  cur.classList.add('active');
  cur.scrollIntoView({ block: 'nearest' });
}

function closeSearch() {
  document.getElementById('search-results').classList.remove('open');
}

const searchInput = document.getElementById('search-input');
const searchClear = document.getElementById('search-clear');
let searchTimer;

searchInput.addEventListener('input', () => {
  searchClear.classList.toggle('show', searchInput.value.length > 0);
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => runSearch(searchInput.value.trim()), 120);
});

searchInput.addEventListener('focus', () => {
  if (searchInput.value.trim()) runSearch(searchInput.value.trim());
});

searchInput.addEventListener('keydown', e => {
  const open = document.getElementById('search-results').classList.contains('open');
  if (e.key === 'ArrowDown' && open) { e.preventDefault(); setActiveHit(activeHit + 1); }
  else if (e.key === 'ArrowUp' && open) { e.preventDefault(); setActiveHit(activeHit - 1); }
  else if (e.key === 'Enter') { e.preventDefault(); gotoHit(activeHit > -1 ? activeHit : 0); }
  else if (e.key === 'Escape') { closeSearch(); searchInput.blur(); }
});

searchClear.addEventListener('click', () => {
  searchInput.value = ''; searchClear.classList.remove('show'); closeSearch(); searchInput.focus();
});

document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) closeSearch();
});

// "/" focuses search from anywhere
document.addEventListener('keydown', e => {
  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
  if (e.key === '/' && !typing) { e.preventDefault(); searchInput.focus(); searchInput.select(); }
});

/* ============================================================
   SCREENSHOT LIGHTBOX
   ============================================================
   HOW TO ADD YOUR OWN PHOTOS
   --------------------------------------------------------------
   Only edit the SHOTS object below. Each entry maps a KEY to:
     { src: "...path or data URI...", caption: "..." }

   OPTION A — External image files (recommended):
     1. Make an "images" folder next to this HTML file.
     2. Drop your screenshots in it (e.g. triage-step1.png).
     3. Point src to it:  src: "images/triage-step1.png"

   OPTION B — Embed the image directly (single self-contained file):
     Paste a base64 data URI:
       src: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUg..."

   TO ADD A BUTTON ANYWHERE IN THE PAGE:
     <button class="shot-btn" data-shot="MY_KEY">📷 View Screenshot</button>
   ============================================================ */
const SHOTS = {
  "upguard-step1": { src: "", caption: "UpGuard — Monitor / create the vendor" },
  "upguard-step2": { src: "", caption: "UpGuard — Edit the vendor profile (summary, attributes, labels, portfolio)" },
  "upguard-step4": { src: "", caption: "UpGuard — Add & analyze evidence in the Security Profile" }
};

function openShot(key) {
  const shot = SHOTS[key];
  const wrap = document.getElementById('lightbox-imgwrap');
  const cap  = document.getElementById('lightbox-caption');
  const box  = document.getElementById('lightbox');
  if (!shot) return;

  cap.textContent = shot.caption || 'Screenshot';

  if (shot.src && shot.src.trim() !== "") {
    wrap.innerHTML = '<img src="' + shot.src + '" alt="' +
      (shot.caption || 'screenshot').replace(/"/g,'&quot;') +
      '" onerror="this.parentNode.innerHTML=\'<div class=&quot;lightbox-missing&quot;><div class=&quot;big&quot;>🖼️</div>Image not found.<br>Check the path in the SHOTS config.</div>\'">';
  } else {
    wrap.innerHTML =
      '<div class="lightbox-missing"><div class="big">📸</div>' +
      'Screenshot coming soon.<br>Add an image for <code>"' + key + '"</code> in the SHOTS config.</div>';
  }
  box.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeShot() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}

document.addEventListener('click', function (e) {
  const trigger = e.target.closest('[data-shot]');
  if (trigger) openShot(trigger.getAttribute('data-shot'));
});

document.querySelectorAll('[data-shot]').forEach(function (el) {
  const s = SHOTS[el.getAttribute('data-shot')];
  if (!s || !s.src || s.src.trim() === "") el.classList.add('missing');
});

document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeShot();
});

// Build the search index last, after all content is in the DOM
buildSearchIndex();


