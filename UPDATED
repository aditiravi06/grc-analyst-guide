  }
  function addMessage(text, role) {
    const message = document.createElement('div');
    message.className = 'utk-ai-message ' + role;
    message.textContent = text;
    messages.appendChild(message);
    messages.scrollTop = messages.scrollHeight;
  }
  function go(tab, label) {
    return label + ' Open the ' + tab + ' tab for the approved procedure.';
  }
  function answer(question) {
    const q = question.toLowerCase();

    // Exact guide rules first. These answers stay within the approved guide content.
    if (/(foreign adversary|adversary attestation)/.test(q)) {
      return 'Pause the review and ask the requester to confirm whether the foreign-adversary attestation was selected in error. Do not continue until it is resolved.';
    }
    if (/(contract|contracts review)/.test(q)) {
      return 'For a contracts review, assign the ticket to Stephen Brown, Dan Fast, or Brian Stubblefield. Add a feed comment explaining the handoff and include the relevant agreement and questions.';
    }
    if (/(vendor meeting|meeting with vendor|schedule.*meeting)/.test(q)) {
      return 'Schedule a vendor review meeting when written documentation does not answer material security questions. Cover data flow, hosting, access, incident response, backups, and remediation; then document actions and decisions in TDX.';
    }
    if (/(gap|questionnaire|coverage|90%)/.test(q)) {
      return 'Send a gap questionnaire when evidence coverage is below 90% or required controls lack evidence. Use the standard two-week due date and review the vendor response in UpGuard.';
    }
    if (/(soc|iso|hecvat|hitrust|evidence|assurance|documentation)/.test(q)) {
      return 'Check UpGuard and prior approval first. When current assurance evidence is missing or outdated, request a SOC 2 Type II report, ISO 27001 documentation, completed HECVAT, or comparable evidence. Evidence should generally be current within three years.';
    }
    if (/(restricted|private|internal use|public|classif|data type|sensitivity)/.test(q)) {
      return 'Classify using the actual data handled and apply the highest level: Public for public information; Internal Use Only for routine non-public data; Private for FERPA academic records, TNID, non-public IP, or sensitive operations; Restricted for PII, PHI, PCI, IDs, accounts, credentials, biometrics, or identifiable research data.';
    }
    if (/(nominal|business impact|criticality|outage|high impact|low impact|critical impact)/.test(q)) {
      return 'Business Impact is based on an outage’s effect on UT as a whole: Nominal is minimal after more than two weeks; Low is adverse over 72 hours to two weeks; High is severe University-wide disruption within 72 hours; Critical can create life-safety risk.';
    }
    if (/(new|open|in progress|awaiting response|on hold|status|time tracking|timeout|stalled)/.test(q)) {
      return 'Use In Progress while actively working and Awaiting Response while waiting on a requester or vendor. The current time map is: New = Time Started; Open and In Progress = Time Running; Awaiting Response and On Hold = Time Paused. For no response, follow the Timeout & Stalled Tickets procedure.';
    }
    if (/(approve|approval|reject|denial|resolved|current activities)/.test(q)) {
      return 'For Security | Data and Technology Risk Review tickets, use Current Activities → Approve Ticket or Reject Ticket. Do not manually set the status to Resolved. Escalate denials to Stephen Brown or Dan Fast before execution.';
    }
    if (/(upguard|vendor profile|risk assessment|score)/.test(q)) {
      return 'Review the existing UpGuard profile, current evidence, open risks, and prior conditions. If no profile exists, create and monitor the vendor, add and analyze evidence, then review the vendor profile. A score above 600 passes the score threshold, but evidence and material risks still need review.';
    }
    if (/(self-hosted|vendor-hosted|hybrid|deployment)/.test(q)) {
      return 'Self-hosted means UT hosts and manages the service; vendor-hosted means the vendor hosts or manages it; hybrid means both environments are involved. Confirm where data is stored, processed, backed up, and accessed.';
    }

    // Safe fallback: pull the most relevant guide text without inventing an answer.
    const words = q.match(/[a-z0-9]{4,}/g) || [];
    const candidates = Array.from(document.querySelectorAll('.tab-panel .card, .tab-panel .alert'))
      .map(el => {
        const t = el.innerText.replace(/\s+/g, ' ').trim();
        const score = words.reduce((n, w) => n + (t.toLowerCase().includes(w) ? 1 : 0), 0);
        return { t, score };
      }).filter(x => x.score > 0).sort((a,b) => b.score - a.score);
    if (candidates.length) return 'I found related guide content: ' + candidates[0].t.slice(0, 420) + (candidates[0].t.length > 420 ? '…' : '');
    return 'I can answer only from this guide. Try asking about data classification, business impact, TDX status or timeouts, UpGuard, vendor documentation, gap questionnaires, vendor meetings, contracts review, or approval and denial. I will answer only from the procedures in this guide.';
  }
  function ask(question) {
    const clean = question.trim();
    if (!clean) return;
    addMessage(clean, 'user');
    input.value = '';
    window.setTimeout(() => addMessage(answer(clean), 'bot'), 120);
  }
  launcher.addEventListener('click', () => setOpen(!panel.classList.contains('open')));
  close.addEventListener('click', () => setOpen(false));
  form.addEventListener('submit', e => { e.preventDefault(); ask(input.value); });
  document.querySelectorAll('[data-ai-question]').forEach(button => button.addEventListener('click', () => ask(button.getAttribute('data-ai-question'))));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && panel.classList.contains('open')) setOpen(false); });
}());
</script>
</body>
</html>
